{
  "name": "nodeatlas",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "net-snmp": "^3.26.0"
  },
  "devDependencies": {
    "electron": "^37.2.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.netmonitor.nodeatlas",
    "productName": "nodesAtlas",
    "copyright": "Leonidas Papadopoulos - leonidas@wna.gr",
    "icon": "build/icon.ico",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "build/**/*",
      "server.js",
      "nodes.example.json",
      "links.example.json",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "NodeAtlas-${version}-portable.exe"
    }
  },
  "description": "nodesAtlas desktop monitoring app",
  "author": {
    "name": "nodesAtlas",
    "email": "support@example.com"
  }
}
